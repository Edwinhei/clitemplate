{
  "name": "@ctl/cli",
  "description": "CLI 装配层：唯一的宿主，负责 boot、持有 cordis.yml、决定装哪些插件",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ctl": "./src/bin.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ctl/env": "workspace:*",
    "@ctl/env-launch": "workspace:*",
    "@ctl/env-static": "workspace:*",
    "@ctl/logger-file": "workspace:*",
    "@ctl/notify": "workspace:*",
    "@ctl/notify-audit": "workspace:*",
    "@ctl/notify-console": "workspace:*",
    "@ctl/notify-file": "workspace:*",
    "@ctl/notify-quiet-policy": "workspace:*",
    "@ctl/tool-notify": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/cordis-plugin-hmr": "catalog:",
    "@deepseek-ai/cordis-plugin-include": "catalog:",
    "@deepseek-ai/cordis-plugin-loader": "catalog:",
    "@deepseek-ai/cordis-plugin-logger-console": "catalog:",
    "@deepseek-ai/cordis-plugin-timer": "catalog:",
    "js-yaml": "catalog:",
    "node-addon-require-builtin": "catalog:"
  },
  "devDependencies": {
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:"
  }
}
