{
  "name": "clitemplate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "ctl": "node apps/cli/src/bin.ts",
    "ctl:tsx": "node --import tsx apps/cli/src/bin.ts",
    "typecheck": "pnpm -r run typecheck",
    "ctl:watch": "CTL_WATCH=1 node apps/cli/src/bin.ts",
    "ctl:dump": "node apps/cli/src/bin.ts --dump-config",
    "verify": "node scripts/verify.ts",
    "check": "pnpm typecheck && pnpm verify"
  },
  "devDependencies": {
    "@types/js-yaml": "catalog:",
    "js-yaml": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
