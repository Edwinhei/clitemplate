{
  "name": "@ctl/env-static",
  "description": "env 提供方：值直接来自 cordis.yml 配置。不碰 process，测试与浏览器可用",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ctl/env": "workspace:*",
    "@deepseek-ai/cordis": "catalog:"
  },
  "devDependencies": {
    "@ctl/env": "workspace:*",
    "@deepseek-ai/cordis": "catalog:"
  }
}
