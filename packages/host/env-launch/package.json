{
  "name": "@ctl/env-launch",
  "description": "启动环境：把 shell 继承的环境变量和 app 自己的 .env 组装成一份分层快照。既是纯函数（宿主引导期用），也是 env 服务的提供方（配置树用）",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ctl/env": "workspace:*",
    "@deepseek-ai/cordis": "catalog:"
  },
  "devDependencies": {
    "@ctl/env": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@types/node": "catalog:"
  }
}
